        "jsCode": "const rows = $input.first().json;\nconst total = (Array.isArray(rows) ? rows : []).reduce((s, r) => s + Number(r.amount || 0), 0);\nconst exp = $('Resolve category_id').first().json;\nreturn [{ json: { ...exp, today_total: total } }];"
      },
