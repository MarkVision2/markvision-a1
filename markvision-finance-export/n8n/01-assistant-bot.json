    {
      "parameters": {
        "jsCode": "const cats = $input.first().json;\nconst list = Array.isArray(cats) ? cats : [];\nreturn [{\n  json: {\n    categories: list,\n    categories_text: list.map(c => `${c.slug} — ${c.name}`).join('\\n')\n  }\n}];"
      },
      "id": "format-cats",
      "name": "Format Categories",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2860, 200]
    },
    {
      "parameters": {
        "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list" },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "=Извлеки информацию о расходе из сообщения пользователя.\n\nТекущее время (ISO): {{ $now.toISO() }}\nЧасовой пояс: Europe/Moscow\n\nДоступные категории (slug — название):\n{{ $json.categories_text }}\n\nВерни строго JSON:\n{\n  \"amount\": число (только сумма, без валюты),\n  \"currency\": \"RUB\" | \"USD\" | \"EUR\" | \"KZT\" | \"UAH\",\n  \"category_slug\": один из доступных slug,\n  \"description\": \"что куплено / на что потрачено\",\n  \"occurred_at\": ISO 8601 (по умолчанию — сейчас)\n}\n\nЕсли валюта не указана — 'RUB'. Если не понятна категория — 'other'."
            },
            { "role": "user", "content": "={{ $('Classify Intent').item.json.input_text }}" }
          ]
        },
        "jsonOutput": true,
        "options": { "temperature": 0 }
      },
      "id": "parse-expense",
      "name": "Parse Expense",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [3080, 200],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_OPENAI_CRED_ID",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const parsed = $input.first().json.message.content;\nconst cats = $('Format Categories').first().json.categories;\nconst found = cats.find(c => c.slug === parsed.category_slug) || cats.find(c => c.slug === 'other');\nreturn [{\n  json: {\n    ...parsed,\n    category_id: found ? found.id : null,\n    category_name: found ? found.name : 'Прочее'\n  }\n}];"
      },
      "id": "resolve-cat",
      "name": "Resolve category_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3300, 200]
    },
