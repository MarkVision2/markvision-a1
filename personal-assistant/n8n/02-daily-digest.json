{
  "name": "Personal Assistant — Daily Digest",
  "nodes": [
    {
      "parameters": {
        "content": "## Ежедневные уведомления\n\nДва расписания:\n- **08:00** — задачи на сегодня + расходы вчера\n- **21:00** — задачи на завтра\n\nЦикл по всем пользователям из `telegram_users`.\n\n### Подключить:\n1. Telegram credential\n2. Заменить `SUPABASE_URL` и `SUPABASE_SERVICE_ROLE_KEY`\n3. Активировать",
        "height": 280,
        "width": 380,
        "color": 4
      },
      "id": "sticky-1",
      "name": "Инструкция",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-300, -50]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }]
        }
      },
      "id": "schedule-morning",
      "name": "08:00 Morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 100]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 21 * * *" }]
        }
      },
      "id": "schedule-evening",
      "name": "21:00 Evening",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 280]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "kind", "value": "morning", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "set-morning",
      "name": "Set kind=morning",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "kind", "value": "evening", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "set-evening",
      "name": "Set kind=evening",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 280]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "SUPABASE_URL",
              "value": "https://zcsxzgigtsdoebtginfy.supabase.co",
              "type": "string"
            },
            {
              "id": "2",
              "name": "SUPABASE_SERVICE_ROLE_KEY",
              "value": "REPLACE_WITH_SERVICE_ROLE_KEY",
              "type": "string"
            },
            { "id": "3", "name": "kind", "value": "={{ $json.kind }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "env",
      "name": "Env",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [640, 190]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.SUPABASE_URL }}/rest/v1/telegram_users",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "user_id,telegram_chat_id" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $json.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $json.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "get-users",
      "name": "Get telegram_users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 190]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json;\nconst env = $('Env').first().json;\nconst out = [];\nfor (const r of (Array.isArray(rows) ? rows : [])) {\n  out.push({ json: {\n    SUPABASE_URL: env.SUPABASE_URL,\n    SUPABASE_SERVICE_ROLE_KEY: env.SUPABASE_SERVICE_ROLE_KEY,\n    kind: env.kind,\n    user_id: r.user_id,\n    telegram_chat_id: r.telegram_chat_id,\n  }});\n}\nreturn out;"
      },
      "id": "flatten",
      "name": "Flatten users",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 190]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.SUPABASE_URL }}/rest/v1/tasks",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "title,starts_at,duration_minutes,description,status" },
            { "name": "user_id", "value": "=eq.{{ $json.user_id }}" },
            { "name": "status", "value": "eq.pending" },
            {
              "name": "starts_at",
              "value": "=gte.{{ $json.kind === 'morning' ? $now.startOf('day').toISO() : $now.plus({ days: 1 }).startOf('day').toISO() }}"
            },
            {
              "name": "starts_at",
              "value": "=lt.{{ $json.kind === 'morning' ? $now.endOf('day').toISO() : $now.plus({ days: 1 }).endOf('day').toISO() }}"
            },
            { "name": "order", "value": "starts_at.asc" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $json.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $json.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "get-tasks",
      "name": "Get Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 190]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Flatten users').item.json.SUPABASE_URL }}/rest/v1/expenses",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "amount,currency,description,expense_categories(name)" },
            { "name": "user_id", "value": "=eq.{{ $('Flatten users').item.json.user_id }}" },
            { "name": "occurred_at", "value": "=gte.{{ $now.minus({ days: 1 }).startOf('day').toISO() }}" },
            { "name": "occurred_at", "value": "=lt.{{ $now.startOf('day').toISO() }}" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('Flatten users').item.json.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $('Flatten users').item.json.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "get-yesterday-exp",
      "name": "Get Yesterday Expenses",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 190]
    },
    {
      "parameters": {
        "jsCode": "const tasks = $('Get Tasks').first().json || [];\nconst expenses = $input.first().json || [];\nconst env = $('Flatten users').first().json;\nconst kind = env.kind;\n\nconst when = kind === 'morning' ? '📅 Задачи на сегодня' : '🌙 Задачи на завтра';\n\nlet text = `${when}\\n`;\nif (Array.isArray(tasks) && tasks.length) {\n  for (const t of tasks) {\n    const time = new Date(t.starts_at).toLocaleString('ru-RU', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Moscow' });\n    text += `\\n• ${time} — ${t.title}`;\n    if (t.description) text += `\\n   _${t.description}_`;\n  }\n} else {\n  text += '\\nПусто 🎉';\n}\n\nif (kind === 'morning') {\n  const exp = Array.isArray(expenses) ? expenses : [];\n  const total = exp.reduce((s, e) => s + Number(e.amount || 0), 0);\n  const byCat = {};\n  for (const e of exp) {\n    const cat = (e.expense_categories && e.expense_categories.name) || 'Прочее';\n    byCat[cat] = (byCat[cat] || 0) + Number(e.amount || 0);\n  }\n  text += `\\n\\n💸 Вчера потрачено: *${total.toFixed(0)} RUB*`;\n  if (exp.length) {\n    for (const [cat, sum] of Object.entries(byCat)) {\n      text += `\\n  • ${cat}: ${sum.toFixed(0)}`;\n    }\n  }\n}\n\nreturn [{ json: { chat_id: env.telegram_chat_id, text } }];"
      },
      "id": "format-msg",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1740, 190]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "tg-send",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1960, 190],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_TELEGRAM_CRED_ID",
          "name": "Telegram (Personal Assistant Bot)"
        }
      }
    }
  ],
