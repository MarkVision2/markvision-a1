# Main Supabase project (admin / agency dashboard).
# These are PUBLISHABLE (anon) keys and are safe to ship to the browser.
# Service-role keys must NEVER appear in any VITE_* variable.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Client-facing Supabase project (per-client dashboards).
VITE_CLIENT_SUPABASE_URL=https://<client-project-ref>.supabase.co
VITE_CLIENT_SUPABASE_PUBLISHABLE_KEY=<client-supabase-publishable-key>
