    {
      "parameters": {
        "jsCode": "// Fetch all unprocessed messages for chat_id, mark them processed, concat into single text\nconst SUPA_URL = 'https://iywmjdrghcbsicdwohmb.supabase.co/rest/v1/mark_message_queue';\nconst SUPA_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml5d21qZHJnaGNic2ljZHdvaG1iIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI4MDk0NzcsImV4cCI6MjA4ODM4NTQ3N30.Km1K3eBIDfSPLWJ42yeKIEQihe3vhKJ0Z-GrCc7AoQI';\n\nconst chatId = $('Set Initial Vars').item.json.chatId;\nconst headers = { apikey: SUPA_KEY, Authorization: 'Bearer ' + SUPA_KEY };\n\n// Get all unprocessed for this chat, ordered by id asc\nconst getR = await fetch(SUPA_URL + '?chat_id=eq.' + encodeURIComponent(chatId) + '&processed=is.false&order=id.asc&select=id,message_text,message_type', { headers });\nconst rows = await getR.json();\n\nif (!Array.isArray(rows) || rows.length === 0) {\n  return [{ json: { chatId, combinedText: '', count: 0, skip: true } }];\n}\n\nconst combined = rows.map(r => r.message_text).join('\\n');\nconst ids = rows.map(r => r.id);\n\n// Mark all as processed\nconst patchR = await fetch(SUPA_URL + '?id=in.(' + ids.join(',') + ')', {\n  method: 'PATCH',\n  headers: { ...headers, 'Content-Type': 'application/json', Prefer: 'return=minimal' },\n  body: JSON.stringify({ processed: true, processed_at: new Date().toISOString() })\n});\n\nreturn [{ json: { chatId, combinedText: combined, count: rows.length, skip: false } }];"
      },
