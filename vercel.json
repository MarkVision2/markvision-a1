{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/autopost/normalize.ts": {
      "maxDuration": 300,
      "memory": 2048
    }
  },
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/api/ig-redirect?code=:code"
    },
    {
      "source": "/g/:slug",
      "destination": "/api/g-redirect?slug=:slug"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/p-redirect?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "ignoreCommand": "git log -1 --pretty=%B | grep -q '\\[vercel-deploy\\]' && exit 1 || exit 0"
}
