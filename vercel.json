{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/montage/burn.ts": {
      "maxDuration": 300,
      "memory": 2048,
      "includeFiles": "api/montage/assets/**"
    },
    "api/autopost/normalize.ts": {
      "maxDuration": 300,
      "memory": 2048
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
