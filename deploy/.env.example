# MarkVision Montage — VPS runtime env. Copy to repo root as .env and fill in.
# Keys the pipeline + workers read. Do NOT commit the filled-in file.

# Transcription (Deepgram nova-3, ru)
DEEPGRAM_API_KEY=

# ElevenLabs (Reels voiceover + video-use Scribe)
ELEVENLABS_API_KEY=

# Live b-roll stock (used by the reels-broll edge fn; keep here for reference)
PEXELS_API_KEY=

# Worker auth — must equal montage_settings.worker_key in Supabase
MONTAGE_WORKER_KEY=

# Supabase project (queue + storage + edge functions)
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_CLIENT_SUPABASE_URL=
VITE_CLIENT_SUPABASE_PUBLISHABLE_KEY=

# Only needed if you run the auto-queue worker (headless Claude Code on a timer).
# Either run `claude login` once as the deploy user, or set an API key here.
# ANTHROPIC_API_KEY=
