{
  "name": "📹 Публикация · 3 · Очередь и мониторинг",
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "nodes": [
    {
      "id": "sched",
      "name": "Каждые 15 минут",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -220,
        0
      ],
      "notes": "Страховка и отчёт. Основной разбор очереди делает pg_cron ежеминутно.",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "cfg",
      "name": "Настройки",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        0,
        0
      ],
      "notes": "Единственное место с секретами: ключ автоматизации Supabase и (опционально) бот/чат Telegram для отчёта.",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c0",
              "name": "supabase_url",
              "value": "https://szfgdruhlebfvcmlvxdk.supabase.co",
              "type": "string"
            },
            {
              "id": "c1",
              "name": "automation_key",
              "value": "PASTE_CRON_SECRET_HERE",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "tg_bot_token",
              "value": "",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "tg_chat_id",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "worker",
      "name": "publish-worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "notes": "Разбор очереди publish_jobs пачкой.",
      "parameters": {
        "method": "POST",
        "url": "={{ $('Настройки').first().json.supabase_url + '/functions/v1/publish-worker' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-automation-key",
              "value": "={{ $('Настройки').first().json.automation_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ batch_size: 10 }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "mon",
      "name": "publish-monitor · ошибки",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "notes": "Гасит аккаунты с серией отказов.",
      "parameters": {
        "method": "POST",
        "url": "={{ $('Настройки').first().json.supabase_url + '/functions/v1/publish-monitor' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-automation-key",
              "value": "={{ $('Настройки').first().json.automation_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mode: 'errors' }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "sum",
      "name": "Сводка",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Сводим два ответа: разбор очереди и монитор аварийных аккаунтов.\n// Молчим, когда сказать нечего, — иначе чат забьётся пустыми тиками.\nconst worker = $('publish-worker').first().json;\nconst monitor = $('publish-monitor · ошибки').first().json;\nconst w = worker.body ?? worker;\nconst m = monitor.body ?? monitor;\n\nconst lines = [];\nif (w.published) lines.push(`✅ Опубликовано: ${w.published}`);\nif (w.failed) lines.push(`❌ Не удалось: ${w.failed}`);\nif (w.manual_review) lines.push(`🔍 На ручной разбор: ${w.manual_review}`);\nif (w.error) lines.push(`⚠️ Воркер: ${w.error}`);\nif (m.disabled) lines.push(`🛑 Отключено аккаунтов по серии ошибок: ${m.disabled}`);\nif (m.manual_review) lines.push(`📋 Всего заданий на разборе: ${m.manual_review}`);\n\nreturn [{ json: {\n  silent: lines.length === 0,\n  claimed: w.claimed ?? 0,\n  published: w.published ?? 0,\n  failed: w.failed ?? 0,\n  text: lines.length ? `📹 Публикации\\n${lines.join('\\n')}` : '',\n} }];"
      }
    },
    {
      "id": "ifq",
      "name": "Есть что сказать?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "q1",
              "leftValue": "={{ $json.silent }}",
              "rightValue": "false",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            },
            {
              "id": "q2",
              "leftValue": "={{ $('Настройки').first().json.tg_bot_token }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "tg",
      "name": "Отчёт в Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -80
      ],
      "notes": "Отчёт уходит только если в «Настройках» заполнены tg_bot_token и tg_chat_id.",
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $('Настройки').first().json.tg_bot_token + '/sendMessage' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Настройки').first().json.tg_chat_id, text: $('Сводка').first().json.text, disable_web_page_preview: true }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": false,
              "neverError": true
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Каждые 15 минут": {
      "main": [
        [
          {
            "node": "Настройки",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Настройки": {
      "main": [
        [
          {
            "node": "publish-worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "publish-worker": {
      "main": [
        [
          {
            "node": "publish-monitor · ошибки",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "publish-monitor · ошибки": {
      "main": [
        [
          {
            "node": "Сводка",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Сводка": {
      "main": [
        [
          {
            "node": "Есть что сказать?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Есть что сказать?": {
      "main": [
        [
          {
            "node": "Отчёт в Telegram",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  }
}
