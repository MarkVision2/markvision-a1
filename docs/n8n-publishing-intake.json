      "notes": "Единственное место с секретами: ключ автоматизации Supabase и (опционально) бот/чат Telegram для отчёта.",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c0",
              "name": "supabase_url",
              "value": "https://szfgdruhlebfvcmlvxdk.supabase.co",
