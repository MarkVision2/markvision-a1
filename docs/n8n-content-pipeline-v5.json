    {
      "id": "openai",
      "name": "OpenAI: сценарий",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1940,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Настройки').first().json.openai_api_key }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $('Задание').first().json.settings.openai_model,\n  temperature: 0.7,\n  response_format: { type: 'json_schema', json_schema: $('Задание').first().json.script_schema },\n  messages: [\n    { role: 'system', content: $('Задание').first().json.script_prompt.system },\n    { role: 'user', content: $('Задание').first().json.script_prompt.user }\n  ]\n}) }}"
      },
      "notes": "Структурированный JSON по схеме из claim. Сеть/5xx — 3 попытки с паузой (retry ноды).",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "parseai",
      "name": "Разбор ответа OpenAI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2180,
        100
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst status = r.statusCode ?? 0;\nconst body = (r.body && typeof r.body === 'object') ? r.body : {};\nconst run_id = $('Задание').first().json.run_id;\nif (status === 429) return [{ json: { ok: false, event: 'fail', run_id, error_code: 'script_provider', kind: 'rate_limited', retry_after: (r.headers || {})['retry-after'] || null, node: 'OpenAI: сценарий', error_message: 'OpenAI HTTP 429' } }];\nif (status < 200 || status >= 300) return [{ json: { ok: false, event: 'fail', run_id, error_code: 'script_provider', kind: status >= 500 ? 'server' : (status === 401 || status === 403 ? 'auth' : 'validation'), node: 'OpenAI: сценарий', error_message: `OpenAI HTTP ${status}: ${JSON.stringify(body).slice(0, 300)}` } }];\nconst raw = body.choices?.[0]?.message?.content ?? '';\nreturn [{ json: { ok: true, event: 'script', run_id, script_raw: raw, model: body.model, usage: body.usage || null, prompt_version: $('Задание').first().json.script_prompt.prompt_version } }];"
      }
    },
