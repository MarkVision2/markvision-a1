    {
      "id": "heygen",
      "name": "HeyGen: создать видео",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3620,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.heygen.com/v2/video/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Api-Key",
              "value": "={{ $('Настройки').first().json.heygen_api_key }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => {\n  const job = $('Задание').first().json;\n  const script = job.script || $('callback: script').first().json.script;\n  const s = job.settings;\n  const character = s.heygen_avatar_id ? { type: 'avatar', avatar_id: s.heygen_avatar_id, avatar_style: 'normal' } : undefined;\n  const voice = { type: 'text', input_text: script.script, voice_id: s.heygen_voice_id || undefined, speed: 1.0 };\n  return JSON.stringify({\n    title: `mv-${job.item_id}-a${job.attempt}`,\n    video_inputs: [{ character, voice }],\n    dimension: { width: s.video_width, height: s.video_height },\n    caption: false\n  });\n})() }}"
      },
      "notes": "Один запрос на попытку. title = id темы + попытка (для сверки в кабинете HeyGen).",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "parsehg",
      "name": "Разбор HeyGen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3860,
        -100
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst status = r.statusCode ?? 0;\nconst body = (r.body && typeof r.body === 'object') ? r.body : {};\nconst run_id = $('Задание').first().json.run_id;\nconst vid = body.data?.video_id;\nif (status >= 200 && status < 300 && vid) return [{ json: { ok: true, event: 'video_requested', run_id, provider: 'heygen', provider_job_id: vid, provider_request_id: (r.headers || {})['x-request-id'] || null } }];\nconst kind = status === 429 ? 'rate_limited' : status >= 500 ? 'server' : (status === 401 || status === 403) ? 'auth' : 'provider_failed';\nreturn [{ json: { ok: false, event: 'fail', run_id, error_code: 'video_provider', kind, retry_after: (r.headers || {})['retry-after'] || null, node: 'HeyGen: создать видео', error_message: `HeyGen HTTP ${status}: ${JSON.stringify(body.error || body).slice(0, 300)}` } }];"
      }
