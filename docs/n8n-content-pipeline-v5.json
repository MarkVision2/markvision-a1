    {
      "id": "gate",
      "name": "Проверка входа",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        0
      ],
      "parameters": {
        "jsCode": "// Тик расписания — без body/headers; вебхук обязан принести x-pipeline-key.\nconst j = $input.first().json;\nconst isWebhook = Boolean(j.body || j.headers);\nif (!isWebhook) return [{ json: { ok: true, project_id: null, source: 'schedule' } }];\nconst key = (j.headers || {})['x-pipeline-key'];\nif (!j.webhook_key || key !== j.webhook_key) return [{ json: { ok: false, error: 'bad webhook key' } }];\nconst b = j.body || {};\nreturn [{ json: { ok: true, project_id: b.project_id || null, item_id: b.item_id || null, source: 'webhook' } }];"
      }
    },
