      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-content",
        "responseMode": "onReceived",
        "options": {}
      },
      "notes": "Ручной запуск из MarkVision (edge-функция шлёт x-pipeline-key). Из браузера напрямую не вызывается.",
      "webhookId": "content-pipeline-generate"
    },
