# Скопируй в .env.local (он гитнорится через *.local) и заполни.
# Эти переменные нужны для MCP-сервера n8n (см. .mcp.json).
# Для Claude Code локально — экспортируй их в шелл перед запуском `claude`.
# Для Claude Code на web — пропиши их в Environment settings.

N8N_API_URL=https://n8n.zapoinov.com/api/v1
# Получить ключ: n8n → Settings → API → Create API Key
N8N_API_KEY=
