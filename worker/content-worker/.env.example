# /etc/markvision-content-worker.env — права 600, владелец root.
# Значения не заполнены намеренно: секреты не хранятся в репозитории.

# Обязательный. Случайная строка ≥ 32 символов; тот же токен — в n8n (x-worker-token).
WORKER_TOKEN=

# Сеть: только приватная Docker-сеть, порт закрыт firewall для всех остальных.
BIND=172.18.0.1
PORT=9120

# Куда класть готовые файлы и по какому адресу Caddy их отдаёт.
MEDIA_DIR=/var/www/media/content-pipeline
PUBLIC_BASE_URL=https://n8n.zapoinov.com/media/content-pipeline

# Источники: только эти домены (точное совпадение или поддомен). Через запятую.
ALLOWED_HOSTS=files2.heygen.ai,files.heygen.ai,resource2.heygen.ai,resource.heygen.ai,static.heygen.ai

# Лимиты
MAX_INPUT_BYTES=314572800
MAX_INPUT_SECONDS=600
JOB_TIMEOUT_MS=480000
DOWNLOAD_TIMEOUT_MS=180000
MAX_CONCURRENCY=2

# Формат результата
TARGET_WIDTH=720
TARGET_HEIGHT=1280
X264_CRF=20
X264_PRESET=medium
AUDIO_BITRATE=128k

# Бинарники (по умолчанию из PATH)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Пороги предупреждений о диске в /health
DISK_WARN_PCT=70
DISK_CRIT_PCT=85
